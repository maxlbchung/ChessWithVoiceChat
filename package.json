{
  "name": "decentralized-chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=chess-vc",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "d1:create": "wrangler d1 create chess-matchmaker",
    "d1:schema": "wrangler d1 execute chess-matchmaker --remote --file=worker/schema.sql"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "chess.js": "^1.0.0-beta.8",
    "idb-keyval": "^6.2.1",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^3.78.0"
  }
}
